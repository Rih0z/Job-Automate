{
  "schema": "harness-provenance/v1",
  "updated": "2026-09-04",
  "purpose": "このリポジトリの harness 要素（原則・rules・hooks・skills・CLAUDE.md セクション）ごとに『Anthropic 公式ベストプラクティス由来』か『著者の運用嗜好』かの由来（provenance）を記録する唯一の SoT。別プロジェクトへのセットアップ時に selection-flow.md がこのファイルを読み、由来別にユーザーへ提示して取捨選択させる。両者を混ぜたまま他環境へ持ち込まないための分離台帳。",
  "provenance_levels": {
    "official": {
      "label": "公式由来",
      "default_selection": "include",
      "description": "Anthropic 公式ドキュメント（best-practices / skills / hooks）に根拠がある要素。文言は焼き込まず、生成時に WebFetch で現行版を取得する。デフォルト採用。外す場合はユーザーが明示する。"
    },
    "official-derived": {
      "label": "公式原則の具体化",
      "default_selection": "recommend",
      "description": "公式が示す原則（例: Writer/Reviewer 分離・progressive disclosure・hooks による決定的強制）を著者が具体的な手順・パラメータに落としたもの。原則は公式、実装は著者。推奨（事前チェック済み）だがユーザーが外せる。"
    },
    "author-preference": {
      "label": "著者の運用嗜好",
      "default_selection": "ask",
      "description": "公式に根拠がない、著者の観察・失敗経験に基づく運用判断（issue フォルダ管理・handoff 規約・並走 recheck 等）。デフォルト非採用。ユーザーが明示的に選んだものだけ持ち込む。"
    },
    "third-party": {
      "label": "第三者由来（vendoring）",
      "default_selection": "ask",
      "description": "外部作者の成果物を vendoring したもの。ライセンス表記を保ったまま、ユーザーが選んだ時のみコピーする。"
    },
    "domain-prompt": {
      "label": "業務ドメインプロンプト",
      "default_selection": "ask",
      "description": "harness とは無関係な業務用プロンプト skill 群。対象プロジェクトの業務に該当するものだけをユーザーが選ぶ。"
    },
    "repo-specific": {
      "label": "本リポジトリ固有",
      "default_selection": "exclude",
      "description": "Job-Automate 自身の構成・索引に依存し、他プロジェクトへ移植する意味がない要素。提示はするが採用不可。"
    }
  },
  "selection_values": {
    "include": "デフォルト採用。ユーザーが明示的に外した時のみ除外",
    "recommend": "推奨。提示時に事前チェック済み。ユーザーが外せる",
    "ask": "デフォルト非採用。ユーザーが明示的に選んだ時のみ採用",
    "exclude": "採用不可。提示のみ"
  },
