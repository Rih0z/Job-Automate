      "file_absent": "path が存在しない",
      "dir_absent": "path のディレクトリが存在しない",
      "grep": "path（ファイルまたはディレクトリ再帰）に pattern（正規表現）が現れる。path が無ければ違反",
      "grep_absent": "path に pattern が現れない。path が無ければ合格",
      "import": "CLAUDE.md に '@<path>' の行があり、かつ path が存在する",
      "frontmatter_paths": "path の frontmatter に paths: がある（path-scope rules）",
      "emphasis_max": "path 内の IMPORTANT / YOU MUST の出現が max 以下",
